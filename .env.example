# ============================================================
# BirthdayBuzz Environment Variables
# ============================================================
# Copy this file to .env.local and fill in the values

# --- Database (Turso) ---
# Create a free database at https://turso.tech
# Run: turso db create birthdaybuzz
# Run: turso db show birthdaybuzz --url
TURSO_DATABASE_URL=libsql://your-database.turso.io
# Run: turso db tokens create birthdaybuzz
TURSO_AUTH_TOKEN=your-auth-token

# --- Web Push (VAPID Keys) ---
# Generate keys by running: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-public-key
VAPID_PRIVATE_KEY=your-private-key
VAPID_SUBJECT=mailto:your-email@example.com

# --- Vercel Cron Security ---
# Set a random secret to protect the cron endpoint
# Generate one: openssl rand -hex 32
CRON_SECRET=your-cron-secret
