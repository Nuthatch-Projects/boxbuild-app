# ============================================================
# DateCue Environment Variables
# ============================================================
# These are automatically set when you add Vercel Postgres
# to your project via the Vercel dashboard. No manual setup needed!

# --- Vercel Postgres (auto-populated by Vercel) ---
# POSTGRES_URL=
# POSTGRES_PRISMA_URL=
# POSTGRES_URL_NON_POOLING=
# POSTGRES_USER=
# POSTGRES_HOST=
# POSTGRES_PASSWORD=
# POSTGRES_DATABASE=

# --- Web Push (VAPID Keys) ---
# Generate keys by running: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-public-key
VAPID_PRIVATE_KEY=your-private-key
VAPID_SUBJECT=mailto:your-email@example.com

# --- Vercel Cron Security ---
CRON_SECRET=your-cron-secret
